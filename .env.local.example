# Admin API Authentication
# Generate a secure random token for admin API access
# Example: openssl rand -base64 32
ADMIN_API_TOKEN=your-secure-admin-token-here

# S3 bucket for admin image uploads (/api/admin/upload)
AWS_BUCKET_REGION=eu-west-1
AWS_PUBLIC_BUCKET_NAME=your-public-bucket-name
MY_AWS_ACCESS_KEY=your-access-key-id
AWS_ACCESS_SECRET_KEY=your-secret-access-key
