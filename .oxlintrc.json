{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // eslint-config-next 16, ported with @oxlint/migrate: the plugins' correctness rules are
  // errors, and `rules` only adds what it enabled outside that category. Paths come from .gitignore.
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "import", "jsx-a11y"],
  "env": {
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/display-name": "error",
    "react/no-unescaped-entities": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/unsupported-syntax": "error",
    "import/no-anonymous-default-export": "error",
    "jsx-a11y/alt-text": ["error", { "elements": ["img"], "img": ["Image"] }]
  }
}
